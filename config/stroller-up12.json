{
  "priority": [
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "average_slope > 12",
      "multiply_by": "0"
    },
    {
      "if": "average_slope < -14",
      "multiply_by": "0"
    },
    {
      "if": "average_slope > 6.0",
      "multiply_by": "0.5"
    },
    {
      "if": "average_slope < -7.0",
      "multiply_by": "0.75"
    }
  ],
  "speed": [
    {
      "if": "average_slope > 6.0",
      "multiply_by": "0.7"
    },
    {
      "else_if": "average_slope > 2",
      "multiply_by": "0.85"
    }
  ]
}
