{
  "priority": [
    {
      "if": "road_class == STEPS",
      "multiply_by": "0"
    },
    {
      "if": "road_class == MOTORWAY || road_class == TRUNK",
      "multiply_by": "0"
    },
    {
      "if": "average_slope > 7",
      "multiply_by": "0"
    },
    {
      "if": "average_slope < -9",
      "multiply_by": "0"
    },
    {
      "if": "average_slope > 3.5",
      "multiply_by": "0.5"
    },
    {
      "if": "average_slope < -4.5",
      "multiply_by": "0.75"
    }
  ],
  "speed": [
    {
      "if": "average_slope > 3.5",
      "multiply_by": "0.7"
    },
    {
      "else_if": "average_slope > 2",
      "multiply_by": "0.85"
    }
  ]
}
